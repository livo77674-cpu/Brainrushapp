<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BrainRush" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#090909</item>
        <item name="android:statusBarColor">#090909</item>
        <item name="android:navigationBarColor">#090909</item>
    </style>

    <style name="Theme.BrainRush.Starting" parent="Theme.SplashScreen">
